<UserControl
    x:Class="UWPTools.Controls.ImageLightboxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UWPTools.Controls">
    <Grid
        x:Name="Root"
        Background="Transparent"
        KeyDown="Root_KeyDown">
        <Grid.Resources>
            <Storyboard x:Name="ShowSb">
                <DoubleAnimation
                    Storyboard.TargetName="Overlay"
                    Storyboard.TargetProperty="Opacity"
                    To="1"
                    Duration="0:0:0.15" />
                <DoubleAnimation
                    Storyboard.TargetName="ContentScale"
                    Storyboard.TargetProperty="ScaleX"
                    To="1"
                    Duration="0:0:0.15" />
                <DoubleAnimation
                    Storyboard.TargetName="ContentScale"
                    Storyboard.TargetProperty="ScaleY"
                    To="1"
                    Duration="0:0:0.15" />
            </Storyboard>
            <Storyboard x:Name="HideSb">
                <DoubleAnimation
                    Storyboard.TargetName="Overlay"
                    Storyboard.TargetProperty="Opacity"
                    To="0"
                    Duration="0:0:0.15" />
                <DoubleAnimation
                    Storyboard.TargetName="ContentScale"
                    Storyboard.TargetProperty="ScaleX"
                    To="0.95"
                    Duration="0:0:0.15" />
                <DoubleAnimation
                    Storyboard.TargetName="ContentScale"
                    Storyboard.TargetProperty="ScaleY"
                    To="0.95"
                    Duration="0:0:0.15" />
            </Storyboard>
        </Grid.Resources>
        <Grid
            x:Name="Overlay"
            Background="#BF000000"
            Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.95" ScaleY="0.95" />
                </Grid.RenderTransform>
                <Grid
                    x:Name="ContentHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    RenderTransformOrigin="0.5,0.5">
                    <FlipView
                        x:Name="Flip"
                        Loaded="Flip_Loaded"
                        SelectionChanged="Flip_SelectionChanged"
                        UseTouchAnimationsForAllNavigation="True">
                        <FlipView.ItemTemplate>
                            <DataTemplate>
                                <local:ImageViewerControl
                                    Loaded="ItemViewer_Loaded"
                                    Source="{Binding}"
                                    Stretch="None" />
                            </DataTemplate>
                        </FlipView.ItemTemplate>
                    </FlipView>
                </Grid>
            </Grid>
            <StackPanel
                Padding="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    x:Name="CloseButton"
                    Width="36"
                    Height="36"
                    Click="CloseButton_Click">
                    <SymbolIcon Symbol="Cancel" />
                </Button>
            </StackPanel>
            <StackPanel
                Padding="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Border
                    Padding="8,4"
                    Background="#33000000"
                    CornerRadius="4">
                    <TextBlock
                        x:Name="PageText"
                        FontSize="14"
                        Foreground="White" />
                </Border>
            </StackPanel>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PrevButton"
                    Grid.Column="0"
                    Width="48"
                    Height="96"
                    Background="#33000000"
                    Click="PrevButton_Click">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Grid.Column="2"
                    Width="48"
                    Height="96"
                    Background="#33000000"
                    Click="NextButton_Click">
                    <SymbolIcon Symbol="Forward" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
