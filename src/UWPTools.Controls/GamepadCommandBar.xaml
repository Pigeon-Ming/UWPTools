<UserControl
    x:Class="UWPTools.Controls.GamepadCommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UWPTools.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="72"
    d:DesignWidth="720"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="GamepadCommandBarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="RootBorder"
        Padding="12,10"
        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsControl x:Name="CommandItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel HorizontalAlignment="Left" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Click="CommandButton_Click"
                            DataContext="{Binding}"
                            IsEnabled="{Binding IsEnabled}"
                            Style="{StaticResource GamepadCommandBarButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    MinWidth="28"
                                    Height="28"
                                    Padding="8,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                    BorderThickness="{Binding IndicatorBorderThickness}"
                                    CornerRadius="14">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="24"
                                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            Text="{Binding GamepadButtonGlyph}"
                                            Visibility="{Binding GamepadButtonGlyphVisibility}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                            Text="{Binding GamepadButtonText}"
                                            Visibility="{Binding GamepadButtonTextVisibility}" />
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{Binding Label}" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{Binding KeyText}"
                                        Visibility="{Binding KeyTextVisibility}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
