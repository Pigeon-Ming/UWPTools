<UserControl
    x:Class="UWPTools.Controls.CreateNewFolderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UWPTools.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="新建文件夹" />
            <TextBlock Margin="0,0,0,4" Text="请为该文件夹取一个名字" />
            <TextBox
                Name="NameTextBox"
                HorizontalAlignment="Stretch"
                x:FieldModifier="public"
                Tapped="NameTextBox_Tapped" />
            <StackPanel
                Margin="0,4,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Name="CancelButton"
                    Margin="0,0,4,0"
                    x:FieldModifier="public"
                    Content="取消" />
                <Button
                    Name="OKButton"
                    x:FieldModifier="public"
                    Content="确认" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
