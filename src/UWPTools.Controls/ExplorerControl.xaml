<UserControl
    x:Class="UWPTools.Controls.ExplorerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UWPTools.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:UWPTools.Controls.Models"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Name="GridViewModeItemTemplate" x:DataType="models:ViewStorageItem">
            <Grid Height="180" MaxWidth="150">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Image
                    Width="128"
                    Height="128"
                    Margin="4"
                    x:Phase="1"
                    Source="{x:Bind Icon}" />

                <TextBlock
                    Grid.Row="1"
                    Margin="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    x:Phase="0"
                    MaxLines="2"
                    Text="{x:Bind Name}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <Style x:Name="GridViewModeListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <ItemsPanelTemplate x:Name="GridViewModeItemsPanelTemplate">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <DataTemplate x:Name="ListViewModeItemTemplate" x:DataType="models:ViewStorageItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image
                    Width="48"
                    Height="48"
                    Margin="4"
                    x:Phase="1"
                    Source="{x:Bind Icon}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    x:Phase="0"
                    MaxLines="3"
                    Text="{x:Bind Name}"
                    TextTrimming="Clip"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <Style x:Name="ListViewModeListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <ItemsPanelTemplate x:Name="ListViewModeItemsPanelTemplate">
            <ItemsStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <ProgressBar
                Name="LoadingProgressBar"
                Grid.Row="0"
                VerticalAlignment="Top"
                Canvas.ZIndex="2"
                IsIndeterminate="True"
                Visibility="Collapsed" />
            <Grid Grid.Row="1" Background="{Binding ElementName=MainCommandBar, Path=Background}">
                <CommandBar
                    Name="MainCommandBar"
                    HorizontalAlignment="Left"
                    DefaultLabelPosition="Right">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton
                            Name="BackButton"
                            Click="BackButton_Click"
                            Icon="Back"
                            Label="后退" />
                        <AppBarButton
                            Name="RefreshButton"
                            Click="RefreshButton_Click"
                            Icon="Refresh"
                            Label="刷新" />
                        <AppBarButton
                            Name="HomeButton"
                            Click="HomeButton_Click"
                            Icon="Home"
                            Label="回到根目录" />
                        <AppBarButton
                            Name="CreateFolderButton"
                            Click="CreateFolderButton_Click"
                            Icon="NewFolder"
                            Label="新建文件夹">
                            <!--<AppBarButton.Flyout>
                                <Flyout x:Name="CreateFolderFlyout" Opened="Flyout_Opened">
                                    <Grid Name="CreateFolderFlyoutGrid" MinHeight="100" MinWidth="300">

                                    </Grid>
                                </Flyout>
                            </AppBarButton.Flyout>-->
                        </AppBarButton>
                        <AppBarButton
                            Name="ViewModeButton"
                            Click="ViewModeButton_Click"
                            Label="网格视图">
                            <AppBarButton.Icon>
                                <FontIcon Name="ViewModeButtonIcon" Glyph="&#xF0E2;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>
            <ScrollViewer
                Height="32"
                Padding="8,0,8,0"
                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled">
                <TextBlock Name="FolderPathTextBlock" VerticalAlignment="Center" />
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <TextBlock
                Name="EmptyFolderTip"
                Margin="8"
                HorizontalAlignment="Center"
                Text="此文件夹为空。"
                Visibility="Collapsed" />
            <ListView
                Name="lvFiles"
                IsItemClickEnabled="True"
                IsMultiSelectCheckBoxEnabled="True"
                ItemClick="lvFiles_ItemClick"
                RightTapped="lvFiles_RightTapped"
                SelectionChanged="OnSelectionChanged"
                SelectionMode="Extended">
                <ListView.ContextFlyout>
                    <MenuFlyout x:Name="ListViewFlyout" Opened="ListViewFlyout_Opened">
                        <MenuFlyoutItem
                            Name="ListViewFlyout_Open"
                            Click="ListViewFlyout_Open_Click"
                            Text="打开">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AD;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator Visibility="{Binding ElementName=ListViewFlyout_Open, Path=Visibility}" />
                        <MenuFlyoutItem
                            Name="ListViewFlyout_Cut"
                            Click="ListViewFlyout_Cut_Click"
                            Text="剪切"
                            Visibility="{Binding ElementName=ListViewFlyout_Open, Path=Visibility}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C6;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Name="ListViewFlyout_Copy"
                            Click="ListViewFlyout_Copy_Click"
                            Text="复制"
                            Visibility="{Binding ElementName=ListViewFlyout_Open, Path=Visibility}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Name="ListViewFlyout_Paste"
                            Click="ListViewFlyout_Paste_Click"
                            Text="粘贴">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator Visibility="{Binding ElementName=ListViewFlyout_Open, Path=Visibility}" />
                        <MenuFlyoutItem Name="ListViewFlyout_OpenFilePath" Click="ListViewFlyout_OpenFilePath_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xED25;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Name="ListViewFlyout_CopyFilePath"
                            Click="ListViewFlyout_CopyFilePath_Click"
                            Text="复制完整路径">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE62F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator Visibility="{Binding ElementName=ListViewFlyout_Open, Path=Visibility}" />
                        <MenuFlyoutItem
                            Name="ListViewFlyout_Delete"
                            Click="ListViewFlyout_Delete_Click"
                            Text="彻底删除"
                            Visibility="{Binding ElementName=ListViewFlyout_Open, Path=Visibility}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Name="ListViewFlyout_Rename"
                            Click="ListViewFlyout_Rename_Click"
                            Text="重命名"
                            Visibility="{Binding ElementName=ListViewFlyout_Open, Path=Visibility}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AC;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Name="ListViewFlyout_Properties"
                            Click="ListViewFlyout_Properties_Click"
                            Text="属性">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <!--<ListView.ItemContainerStyle>

            </ListView.ItemContainerStyle>-->
                <!--<ItemsControl.ItemTemplate>

            </ItemsControl.ItemTemplate>-->
                <!--<ItemsControl.ItemsPanel>

            </ItemsControl.ItemsPanel>-->
            </ListView>
        </Grid>
    </Grid>
</UserControl>
