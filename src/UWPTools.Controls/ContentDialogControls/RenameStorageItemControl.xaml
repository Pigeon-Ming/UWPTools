<UserControl
    x:Class="UWPTools.Controls.ContentDialogControls.RenameStorageItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UWPTools.Controls.ContentDialogControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="重命名" />
        <TextBox
            Name="NameTextBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            x:FieldModifier="public" />
        <StackPanel
            Grid.Row="2"
            Margin="0,4,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Name="CancelButton"
                Margin="0,0,4,0"
                x:FieldModifier="public"
                Content="取消" />
            <Button
                Name="OKButton"
                x:FieldModifier="public"
                Content="确认" />
        </StackPanel>
    </Grid>
</UserControl>
