<UserControl
    x:Class="UWPTools.Controls.ContentDialogControls.StorageItemPropertiesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UWPTools.Controls.ContentDialogControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image
                Name="IconImage"
                Width="48"
                Height="48"
                Margin="0,0,24,0"
                Source="{x:Bind ViewStorageItem.Icon, Mode=OneWay}" />
            <TextBlock
                Name="NameTextBlock"
                Grid.Column="1"
                VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer
            Grid.Row="1"
            Margin="4,8,0,0"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel Name="PropertiesStackPanel" Margin="0,0,0,0" />
        </ScrollViewer>
        <Grid Grid.Row="2">
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Name="CancelButton"
                    Margin="0,0,4,0"
                    x:FieldModifier="public"
                    Content="关闭" />
                <!--<Button Content="确定" Name="OkButton" x:FieldModifier="public"/>-->
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
