<Page
    x:Class="UWPTools.Pages.ControlPages.ImageViewerControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UWPTools.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UWPTools.Pages.ControlPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Padding="12"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock Text="*该控件由AI生成" />
            <Button
                x:Name="OpenButton"
                Click="OpenButton_Click"
                Content="打开图片" />
        </StackPanel>
        <Grid Grid.Row="1" Padding="12">
            <GridView
                x:Name="ThumbsView"
                IsItemClickEnabled="True"
                ItemClick="ThumbsView_ItemClick"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="96"
                            Height="96"
                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                            <Image
                                Width="96"
                                Height="96"
                                Source="{Binding}"
                                Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
